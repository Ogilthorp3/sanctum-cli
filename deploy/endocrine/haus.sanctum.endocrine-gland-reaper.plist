<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Separate from haus.sanctum.endocrine-gland. SIGKILLs that job's pid when
  the same pid is still running past the 25s wall, including a stall in
  xpcproxy before endocrine-tick.sh can arm its own timer. Does not
  kickstart. ProcessType stays Standard so this job is not deferred with
  the Background gland beat.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>haus.sanctum.endocrine-gland-reaper</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/bert/.sanctum/scripts/endocrine-tick-reaper.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/bert</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/Users/bert/.sanctum/logs/endocrine-gland-reaper.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/bert/.sanctum/logs/endocrine-gland-reaper.log</string>
</dict>
</plist>
