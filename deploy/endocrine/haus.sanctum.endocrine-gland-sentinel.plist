<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  STAGED — NOT LOADED. Watches the gland (the seventh organ) and pages Force
  Flow ONLY on a pathological state, damped via alert-confirm.sh (probe-twice +
  cooldown). Observe-only: never restarts/doses anything.
  Operator turns it on (@OPERATOR_HOME@ expanded at install):
      cp endocrine-gland-sentinel.py ~/.sanctum/sentinels/
      sed "s|@OPERATOR_HOME@|$HOME|g" haus.sanctum.endocrine-gland-sentinel.plist > ~/Library/LaunchAgents/haus.sanctum.endocrine-gland-sentinel.plist
      launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/haus.sanctum.endocrine-gland-sentinel.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>haus.sanctum.endocrine-gland-sentinel</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>@OPERATOR_HOME@/.sanctum/sentinels/endocrine-gland-sentinel.py</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>@OPERATOR_HOME@</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>ProcessType</key>
    <string>Standard</string>
    <key>StandardOutPath</key>
    <string>@OPERATOR_HOME@/.sanctum/logs/endocrine-gland-sentinel.log</string>
    <key>StandardErrorPath</key>
    <string>@OPERATOR_HOME@/.sanctum/logs/endocrine-gland-sentinel.log</string>
</dict>
</plist>
